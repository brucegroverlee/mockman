{
  "name": "mockman",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome DevTools extension for mocking network responses, with a nested folder tree, tagging, per-tab scoping and MCP access",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "mcp-config": "node scripts/print-mcp-config.mjs",
    "verify:serve": "node verify/server.mjs extension/dist",
    "verify:mcp": "node verify/mcp-check.mjs mcp-server/dist/index.js 8791",
    "verify:bridge": "node verify/mcp-bridge-check.mjs mcp-server/dist/index.js 8793"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "ws": "^8.21.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    }
  }
}
